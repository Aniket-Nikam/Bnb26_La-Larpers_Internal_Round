# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_PROFILE=normal
PUBLIC_ORIGIN=https://fairdrop.example.invalid
POSTGRES_DB=fairdrop
POSTGRES_USER=fairdrop
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://fairdrop:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/fairdrop
REDIS_URL=redis://redis:6379/0
SESSION_DIGEST_KEY=CHANGE_ME_32_BYTE_RANDOM_SESSION_KEY
CREDENTIAL_DIGEST_KEY=CHANGE_ME_32_BYTE_RANDOM_CREDENTIAL_KEY
SEED_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_AES_KEY
COOKIE_SECURE=true

# Lab defaults. Normal Compose forces all lab capabilities off.
LAB_TARGET_ORIGIN=http://gateway
LAB_MAX_RPS=2000
LAB_MAX_IDENTITIES=50000
LAB_MAX_DURATION_SECONDS=300
LAB_MAX_TRIALS=20
LAB_MAX_RETRIES_PER_ACTOR=20
LAB_ARTIFACT_ROOT=/var/lib/fairdrop/lab
LAB_PRIVATE_FIXTURE_ROOT=/run/secrets/fairdrop-lab
